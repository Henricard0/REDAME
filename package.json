{
  "name": "redame",
  "version": "0.1.0",
  "private": true,
  "description": "REDAME: O Resgate do Legado - aventura em pixel art para navegador",
  "scripts": {
    "build": "esbuild jogo/main.js --bundle --format=iife --target=es2020 --outfile=jogo.js",
